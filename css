* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  user-select: none;
  -webkit-user-select: none;
}

body {
  background: radial-gradient(circle at top, #ffd6e7 0%, #ffb3d1 55%, #f48fb1 100%);
  font-family: 'Press Start 2P', monospace;
  color: #6d1b43;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12px;
}

.arcade-frame {
  background: #fff0f6;
  border: 6px solid #d81b60;
  box-shadow: 0 10px 0 #ad1457, 0 18px 30px rgba(136, 14, 79, 0.35);
  border-radius: 14px;
  padding: 14px;
  max-width: 840px;
  width: 100%;
}

.hud {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #ffdce9;
  border: 4px solid #f06292;
  padding: 10px 14px;
  margin-bottom: 12px;
  font-size: 12px;
}

.hud-item {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.hud-item .label {
  font-size: 9px;
  color: #ad1457;
}

.hearts {
  color: #e91e63;
  font-size: 15px;
  letter-spacing: 3px;
}

.icon-btn {
  background: #ff80ab;
  border: 3px solid #ad1457;
  box-shadow: 0 3px 0 #ad1457;
  padding: 6px 10px;
  font-size: 14px;
  cursor: pointer;
}

.icon-btn:active {
  transform: translateY(2px);
  box-shadow: 0 1px 0 #ad1457;
}

.canvas-wrapper {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 9;
  border: 4px solid #ad1457;
  background: #ffe6f0;
  overflow: hidden;
}

canvas {
  width: 100%;
  height: 100%;
  display: block;
  image-rendering: pixelated;
  image-rendering: crisp-edges;
}

.overlay {
  position: absolute;
  inset: 0;
  background: rgba(255, 228, 240, 0.92);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 24px;
  gap: 18px;
}

.overlay.hidden {
  display: none;
}

.overlay h1 {
  font-size: clamp(16px, 3vw, 24px);
  color: #c2185b;
  text-shadow: 3px 3px 0 #ffc1e3;
  line-height: 1.4;
}

.overlay p {
  font-size: clamp(10px, 1.8vw, 12px);
  line-height: 1.7;
  max-width: 560px;
  color: #7b1fa2;
}

.controls-hint {
  display: flex;
  gap: 20px;
  font-size: 10px;
  background: #fff;
  border: 3px dashed #f48fb1;
  padding: 10px 14px;
  color: #ad1457;
}

.pixel-btn {
  font-family: 'Press Start 2P', monospace;
  font-size: 13px;
  background: #ff4081;
  color: #fff;
  border: 4px solid #880e4f;
  box-shadow: 0 5px 0 #880e4f;
  padding: 14px 22px;
  cursor: pointer;
  transition: transform 0.08s;
}

.pixel-btn:hover {
  background: #f50057;
}

.pixel-btn:active {
  transform: translateY(4px);
  box-shadow: 0 1px 0 #880e4f;
}

/* Controles Mobile */
.touch-controls {
  display: none;
  justify-content: space-between;
  margin-top: 12px;
  gap: 12px;
}

.touch-left {
  display: flex;
  gap: 12px;
}

.touch-btn {
  font-family: 'Press Start 2P', monospace;
  font-size: 16px;
  background: #ff80ab;
  color: #fff;
  border: 4px solid #ad1457;
  box-shadow: 0 4px 0 #ad1457;
  padding: 14px 20px;
  border-radius: 8px;
}

.touch-btn:active {
  transform: translateY(3px);
  box-shadow: 0 1px 0 #ad1457;
}

@media (max-width: 768px) {
  .touch-controls {
    display: flex;
  }
}